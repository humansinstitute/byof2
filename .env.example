# No private Nostr keys or provider keys belong in this application.
NODE_ENV=production
PUBLIC_ORIGIN=https://your-new-byo-freedom.example
# Optional comma-separated exact legacy origins (max 4), no trailing slashes.
PUBLIC_ORIGIN_ALIASES=
PORT=3000
DATABASE_PATH=/app/data/byo.sqlite
APP_VERSION=0.1.0
# Public hex signer identities; activation is configured through the supported
# managed WApp installation broker. Never paste human/agent private keys.
WORKER_PUBKEY=
AUTOPILOT_WEBHOOK_PUBKEY=
# Public RemotePipelineConfig JSON per exact managed grant/definition.
# Includes origin, clientOrigin, installationId, appId, ownerNpub, definitionId,
# callbackUrl, appPubkey. Server-only opaque execution grants go in *_CREDENTIAL;
# startup writes0600 files under the data volume. Never expose them to browsers.
INTERVIEW_PIPELINE_CONFIG=
BUILDER_PIPELINE_CONFIG=
INTERVIEW_PIPELINE_CREDENTIAL=
BUILDER_PIPELINE_CREDENTIAL=

# Reviewed BYO-only storage gateway; opaque server capability, never a Nostr key.
BYO_NSTACK_GATEWAY_URL=
BYO_NSTACK_GATEWAY_CREDENTIAL=
# Alternatively mount a0600 capability file; startup credential materializes on data volume.
BYO_NSTACK_GATEWAY_TOKEN_FILE=
# Optional admin-only public metadata choices; never credentials or installation IDs.
# JSON array: [{"name":"My provisioned NStack","endpoint":"https://stack.example","serviceNpub":"<tower-npub>","workspaceOwnerNpub":"<workspace-owner-npub>","appNpub":"<app-npub>"}]
# Leave empty when no reviewed connection has been provisioned. Choosing a hint does not save/test it.
BYO_NSTACK_CONNECTIONS_JSON=

# Optional trusted host checkout used by operator-native pipeline helpers.
# Defaults to the current user's code/wm/autopilot directory; never a credential.
AUTOPILOT_REPO=
